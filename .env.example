# Conexión a PostgreSQL
DATABASE_URL="postgresql://gradus:gradus@localhost:5432/gradus?schema=public"

# Clave para cifrar datos sensibles en la base (secretos de la verificación en
# dos pasos). Obligatoria en producción: generar con `openssl rand -base64 48`.
# No cambiarla ni perderla. En desarrollo se usa una clave fija si falta.
# SECRET_KEY=""

# Sólo para probar por HTTP en la red local. Nunca en producción con datos reales.
# COOKIE_SECURE=false

# URL pública del sitio (para los enlaces de los emails)
# APP_URL="https://gradus.ejemplo.com"

# Carpeta para los adjuntos (conviene ruta absoluta con backup)
# STORAGE_DIR="/var/lib/gradus/storage"

# Notificaciones push: generar con `npm run push:keys`
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:sistemas@ejemplo.com"

# Email (opcional). Ejemplo: smtps://usuario:clave@smtp.gmail.com:465
# SMTP_URL=""
# MAIL_FROM="Gradus <no-responder@ejemplo.com>"
